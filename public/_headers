/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/data/*
  Cache-Control: no-cache

/methodology.html
  Cache-Control: no-cache

/actions.html
  Cache-Control: no-cache

/decisions.html
  Cache-Control: no-cache

/transparency.html
  Cache-Control: no-cache

/lobby.html
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/about.html
  Cache-Control: no-cache

/money-summary.js
  Cache-Control: no-cache

/decision-card.js
  Cache-Control: no-cache

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/precinct-filter.js
  Cache-Control: no-cache

/api.html
  Cache-Control: no-cache
